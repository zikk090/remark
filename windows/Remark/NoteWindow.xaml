<Window x:Class="Remark.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remark note"
        Width="452" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Opacity="0"
        FontFamily="{StaticResource UiFont}">

    <Border Margin="14" CornerRadius="14" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22" Direction="270" />
        </Border.Effect>

        <StackPanel Margin="16,12,16,12">

            <!-- Header (drag to move) -->
            <Grid x:Name="Header" Background="Transparent" Margin="0,0,0,10" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderIcon" FontFamily="{StaticResource IconFont}" Text="&#xE8BD;"
                           Foreground="{StaticResource AccentBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock x:Name="SessionTitle" Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" />
                <TextBlock x:Name="ContextText" Grid.Column="2" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>

            <!-- Screenshot -->
            <Border x:Name="ImageFrame" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Background="#F6F5F9" Margin="0,0,0,10" ClipToBounds="True">
                <Image x:Name="Shot" MaxHeight="180" Stretch="Uniform" StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- Quoted text (selection or OCR) -->
            <StackPanel x:Name="QuotePanel" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid Margin="0,0,0,4">
                    <TextBlock x:Name="QuoteLabel" Text="Selected text" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <Button x:Name="RemoveQuote" Content="Remove" HorizontalAlignment="Right" Padding="4,0"
                            FontSize="11" Foreground="{StaticResource AccentDeepBrush}" Style="{StaticResource GhostButton}" />
                </Grid>
                <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0"
                        Background="{StaticResource AccentSoftBrush}" CornerRadius="0,6,6,0" Padding="10,6">
                    <TextBlock x:Name="QuoteText" TextWrapping="Wrap" FontSize="12" MaxHeight="130"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </StackPanel>

            <!-- Kind -->
            <Border Background="#EFEDF4" CornerRadius="8" Padding="2" Margin="0,0,0,10">
                <UniformGrid x:Name="KindBar" Rows="1" />
            </Border>

            <!-- Note -->
            <Grid Margin="0,0,0,8">
                <TextBox x:Name="Editor" Height="104" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="13.5" Padding="8,6"
                         BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White" />
                <TextBlock x:Name="Placeholder" Text="Type a note, or hit Talk and speak" Margin="11,8,0,0"
                           Foreground="#A9A3B3" FontSize="13.5" IsHitTestVisible="False" />
            </Grid>

            <TextBlock x:Name="Message" Foreground="{StaticResource AccentDeepBrush}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

            <!-- Actions -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TalkButton" Style="{StaticResource BaseButton}" Padding="12,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TalkIcon" FontFamily="{StaticResource IconFont}" Text="&#xE720;" FontSize="13"
                                       Foreground="{StaticResource AccentDeepBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="TalkLabel" Text="Talk" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OcrButton" Style="{StaticResource BaseButton}" Padding="12,6"
                            ToolTip="Pull the text out of this screenshot (Ctrl+E)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D2;" FontSize="13"
                                       Foreground="{StaticResource AccentDeepBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="OcrLabel" Text="Text" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DiscardButton" Content="Discard" Style="{StaticResource GhostButton}" Margin="0,0,4,0" />
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Padding="18,6" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="Hint" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="10.5"
                       Foreground="#A9A3B3" />
        </StackPanel>
    </Border>
</Window>
