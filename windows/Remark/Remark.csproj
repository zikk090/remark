<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>Remark</AssemblyName>
    <RootNamespace>Remark</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Remark.ico</ApplicationIcon>

    <Version>0.4.0</Version>
    <Product>Remark</Product>
    <Company>Ezinne Kalu</Company>
    <Copyright>© 2026 Ezinne Kalu</Copyright>
    <Description>Select anything on your screen, talk or type a note, and send a clean report.</Description>

    <!-- Quiet the WinForms/WPF interop analyzers that don't apply here. -->
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2024.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Remark.ico" />
    <Resource Include="Assets\Remark-256.png" />
  </ItemGroup>

</Project>
